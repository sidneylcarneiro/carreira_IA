# Copie este arquivo para .env e preencha os valores reais.
# NUNCA versione o arquivo .env real.

# Banco de dados
DATABASE_URL=postgresql://user:password@localhost/mydb

# API do DeepSeek (chave real)
DEEPSEEK_API_KEY=

# Chave usada para assinar os cookies de sessão (troque em produção)
# IMPORTANTE: mantenha o MESMO valor em todas as execuções/containers.
# Se o secret mudar, cookies antigos ficam inválidos e o login com Google
# passa a falhar com "mismatching_state".
SESSION_SECRET=dev-secret-change-me

# --- Login com Google (OAuth) ---
# Crie as credenciais em https://console.cloud.google.com/apis/credentials
# e adicione a URI de redirecionamento: {URL de acesso}/auth/google
# (ex.: http://localhost:8000/auth/google e http://127.0.0.1:8000/auth/google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# URL pública do app (usada para montar o redirect do Google).
# Se estiver vazio neste campo abaixo (oauth), o redirect é derivado do host
# usado no navegador — o que evita o erro de "state" quando você alterna
# entre localhost e 127.0.0.1. Preencha OAUTH_REDIRECT_BASE_URL apenas quando
# for atrás de proxy reverse com URL pública diferente da interna
# (ex.: https://meusite.com).
BASE_URL=http://localhost:8000
OAUTH_REDIRECT_BASE_URL=

# Em debug, o callback do OAuth expõe o erro real em JSON em vez de redirecionar.
# Deixe false em produção.
OAUTH_DEBUG=false